# ── Build artifacts ──
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/
.settings/
__pycache__/
*.pyc

# ── Flash / mobile executables ──
*.swf
*.air
*.ipa
*.apk

# ── Model weights (large binary) ──
*.pt
*.pth

# ── NPZ sample data (large, generated) ──
*.npz

# ── Large latent records ──
body_latent_*.json

# ── Outputs (all generated run artifacts) ──
/outputs/

# ── Data: keep metadata, ignore heavy generated samples ──
# Allow: dataset.json, *.csv, *.json (stats, splits, indices)
# Block: meridian_samples/, airfoil_samples/ (NPZ directories)
/data/*/processed/meridian_samples/
/data/*/processed/airfoil_samples/
/data/*/processed/*_sdf_samples/
# Block raw PDF / CAD / FEM in data
/data/*/raw/
/data/*/results/
/data/*/not_fem/
/data/airfoil/raw/
